{
  "name": "bible-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "import:openbible": "node scripts/sync-openbible-data.mjs",
    "validate:data": "node scripts/validate-atlas-data.mjs",
