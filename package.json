    "preview": "vite preview --host 0.0.0.0",
    "preview:fixtures": "node scripts/serve-ui-fixtures.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^6.15.0"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "vite": "^8.0.16"
  }
